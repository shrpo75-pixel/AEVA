# AEVA OS - Environment Configuration
# Copy this file to .env and fill in your credentials

# NVIDIA API Configuration
# Get your API key from: https://integrate.api.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional: OpenAI API (for fallback provider)
# OPENAI_API_KEY=your_openai_api_key_here

# Application Configuration
AEVA_DEBUG=false
AEVA_PORT=8501
AEVA_HOST=localhost

# Feature Flags
ENABLE_VOICE_INPUT=false
ENABLE_VISION_MODELS=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_NOVEL_STUDIO=true
ENABLE_QUANTUM_FORGE=true
ENABLE_DEV_STUDIO=true

# Performance
MAX_TOKENS=2048
STREAMING_CHUNK_SIZE=50
CONTEXT_WINDOW_SIZE=4096

# Storage
DATA_DIR=./data
CACHE_DIR=./.streamlit/cache

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/aeva.log
